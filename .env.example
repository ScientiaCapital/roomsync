# roomsync settings. Copy to .env and fill in. .env is gitignored; never commit real values.
# Video platform API (Panopto first). Use a test or demo site until a person approves a real one.
ROOMSYNC_PANOPTO_BASE_URL=
ROOMSYNC_PANOPTO_CLIENT_ID=
ROOMSYNC_PANOPTO_CLIENT_SECRET=
# Dry run is the default. Nothing is created on the platform unless this is 0 and a person approves each plan.
ROOMSYNC_DRY_RUN=1
